RewriteEngine On

# HTTP → HTTPS redirect via port detection (safe for InfinityFree/openresty proxy).
# Avoids X-Forwarded-Proto which causes redirect loops with InfinityFree's anti-bot.
RewriteCond %{SERVER_PORT} 80
RewriteRule ^(.*)$ https://www.mariogijon.es/$1 [R=301,L]

# Serve static assets directly (images, fonts, icons, etc.)
# Allows social bots (LinkedIn, WhatsApp) to fetch og:image without SPA redirect.
RewriteRule \.(jpg|jpeg|png|gif|webp|svg|ico|woff2?|ttf|eot|css|js|json|xml|txt|map)$ - [L]

# SPA fallback for client-side routes (React Router/Vite).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
